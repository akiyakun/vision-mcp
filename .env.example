OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Generate a separate token; do not use your OpenAI key here.
VISION_MCP_TOKEN=
# Default is localhost only. For LAN use, set BOTH to the NAS's LAN IP.
MCP_BIND_IP=127.0.0.1
SERVER_IP=127.0.0.1
# Host port only; the container listens on 8000.
MCP_PORT=8001
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# This is a NAS-host path, NOT a Windows path or this Mac's /Volumes mount.
VISION_IMAGE_DIR=./images
# Supplementary group for reading the image share (NAS numeric GID).
VISION_IMAGE_GID=10001
VISION_MAX_OUTPUT_TOKENS=800
VISION_MAX_CALLS_PER_DAY=20
VISION_MAX_CALLS_PER_10_MIN=3
